{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://house-band.local/schemas/source-song.schema.json",
  "title": "house-band-source-song",
  "description": "Imported user piece for co-write (MIDI, tracker, XRNS). Beats are quarter notes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "title",
    "tempo",
    "tempoMap",
    "timeSignature",
    "lengthBeats",
    "tracks",
    "sequence",
    "provenance"
  ],
  "properties": {
    "format": {
      "type": "string",
      "const": "house-band-source-song"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "tempo": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "First tempo in BPM (same as tempoMap[0].bpm)."
    },
    "tempoMap": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["beat", "bpm"],
        "properties": {
          "beat": { "type": "number", "minimum": 0 },
          "bpm": { "type": "number", "exclusiveMinimum": 0 }
        }
      },
      "description": "Every tempo change; first entry must be at beat 0."
    },
    "timeSignature": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "exclusiveMinimum": 0 },
      "description": "[numerator, denominator], for example [4, 4]."
    },
    "lengthBeats": {
      "type": "number",
      "minimum": 0,
      "description": "Song length in quarter-note beats."
    },
    "tracks": {
      "type": "array",
      "items": { "$ref": "#/$defs/track" }
    },
    "sequence": {
      "description": "Pattern order for tracker input; null for MIDI.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "importer", "importerVersion"],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "description": "Basename only of the imported file."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "importer": {
          "type": "string",
          "minLength": 1
        },
        "importerVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "instrumentName",
        "kind",
        "roleGuess",
        "notes"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "instrumentName": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["pitched", "drums"] },
        "roleGuess": {
          "type": "string",
          "enum": ["melody", "bass", "chords", "drums", "other"]
        },
        "notes": {
          "type": "array",
          "items": { "$ref": "#/$defs/note" }
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beat", "lengthBeats", "midi", "velocity", "offsetMs"],
      "properties": {
        "beat": { "type": "number", "minimum": 0 },
        "lengthBeats": { "type": "number", "exclusiveMinimum": 0 },
        "midi": { "type": "integer", "minimum": 0, "maximum": 127 },
        "velocity": { "type": "number", "minimum": 0, "maximum": 1 },
        "offsetMs": { "type": "number" }
      }
    }
  }
}
